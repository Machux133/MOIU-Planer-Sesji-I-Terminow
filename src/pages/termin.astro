---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SzczegolyZAdresu } from '../components/SzczegolyTerminu';
import { url } from '../lib/url';
---
<Layout tytul="Szczegóły terminu">
  <Breadcrumbs sciezka={[
    { etykieta: 'Start', href: url('/') },
    { etykieta: 'Terminy', href: url('/terminy') },
    { etykieta: 'Szczegóły' },
  ]} />
  <p><a href={url('/terminy')}>‹ Wróć do listy</a></p>
  <SzczegolyZAdresu client:only="react">
    <p slot="fallback">Ładowanie…</p>
  </SzczegolyZAdresu>
</Layout>
